# ComicVine API Key
# Get your free API key from https://comicvine.gamespot.com/api/
# COMICVINE_API_KEY=your_api_key_here

# Optional: Set the parent directory for comic processing folders
# PARENT_DIR=/Volumes/Storage/comics

# Optional: Set log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# Komga Configuration (optional)
# KOMGA_LIBRARY_PATH=/path/to/komga/library
# KOMGA_URL=http://komga.local:8585
# KOMGA_API_KEY=your_komga_api_key
# KOMGA_SMB_PATH=smb://truenas.local/comics
# KOMGA_SMB_USERNAME=your_username
# KOMGA_SMB_PASSWORD=your_password